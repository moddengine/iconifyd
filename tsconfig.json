{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "outDir": "dist/client",
    "skipLibCheck": true
  },
  "include": ["client/**/*.ts"],
  "exclude": ["client/**/*.spec.ts"]
}
